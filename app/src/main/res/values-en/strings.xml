    <string name="oss_licenses">Open Source Licenses</string>
    <string name="oss_intro">Qubit Explorer uses the following open source libraries:</string>
    <string name="privacy_local_title">• Local Use and Private Network:</string>
    <string name="privacy_local_body">Qubit Explorer operates 100% locally and on your Local Area Network (LAN). None of your files, names, paths or network credentials (SMB/FTP) are sent to external servers or trackers.</string>
    <string name="privacy_storage_title">• Full Storage Permission:</string>
    <string name="privacy_storage_body">The MANAGE_EXTERNAL_STORAGE permission is requested for the sole purpose of letting you browse, move, transfer, search and organize files in internal storage and SD cards.</string>
    <string name="privacy_creds_title">• Credential Encryption:</string>
    <string name="privacy_creds_body">Passwords for your SMB and FTP servers are stored encrypted with the Android Keystore, in the app\'s private storage.</string>
